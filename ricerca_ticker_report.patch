+// Ricerca ticker su TUTTI i basket del repository (AZ_TITOLI è già l'unione di tutti i basket).
+// Match esatto sul ticker completo, poi sul codice base senza suffisso borsa (.MI/.DE/.PA/.L...),
+// infine un contains su ticker/nome per chi digita solo un pezzo. Ambiguità -> lista da scegliere.
+function doTickerSearch(){
+  const raw = document.getElementById('tickerSearchInput').value.trim();
+  const resultsEl = document.getElementById('tickerSearchResults');
+  if(!raw){ resultsEl.innerHTML = ''; return; }
+  const q = raw.toUpperCase();
+  const base = q.split('.')[0];
+  let matches = AZ_TITOLI.filter(t => t.ticker.toUpperCase() === q);
+  if(!matches.length) matches = AZ_TITOLI.filter(t => t.ticker.toUpperCase().split('.')[0] === base);
+  if(!matches.length) matches = AZ_TITOLI.filter(t => t.ticker.toUpperCase().includes(q) || (t.nome||'').toUpperCase().includes(q));
+
+  if(!matches.length){
+    resultsEl.innerHTML = `<div class="warn-banner">⚠️ Nessun ticker trovato per "${raw}" in nessuno dei basket (${BASKET_ORDER.map(b=>REGIONE_LABEL[b]||b).join(', ')}).</div>`;
+    return;
+  }
+  if(matches.length===1){
+    resultsEl.innerHTML = '';
+    document.getElementById('tickerSearchInput').value = '';
+    openChart(matches[0].ticker);
+    return;
+  }
+  resultsEl.innerHTML = `<div style="font-size:11px;color:var(--text3);margin-bottom:4px">${matches.length} risultati — scegli quello giusto:</div>` +
+    matches.slice(0,15).map(t=>`<span class="rowbtn search-result-item" onclick="openChart('${t.ticker}');document.getElementById('tickerSearchResults').innerHTML='';document.getElementById('tickerSearchInput').value=''">${t.ticker} — ${t.nome} <span style="color:var(--text3)">(${REGIONE_LABEL[t.regione]||t.regione})</span></span>`).join('');
+}
